// BlueWaste System ERD (DBML)
// Source: backend/prisma/schema.prisma

Enum Role {
  CITIZEN
  LGU_ADMIN
  FIELD_WORKER
}

Enum ReportStatus {
  PENDING
  VERIFIED
  CLEANUP_SCHEDULED
  IN_PROGRESS
  CLEANED
  REJECTED
}

Enum WasteCategory {
  with_waste
  no_waste
}

Enum ImageType {
  REPORT
  CLEANUP
}

Enum NotificationType {
  NEW_REPORT
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
  CLEANUP_SCHEDULE
}

Enum CleanupScheduleStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

Enum WasteType {
  PLASTIC
  ORGANIC
  GLASS
  METAL
  PAPER
}

Enum AnalysisStatus {
  DIRTY
  CLEAN
}

Enum Severity {
  CRITICAL
  HIGH
  MODERATE
  SPAM
}

Table User {
  id         uuid      [pk]
  email      varchar   [unique]
  password   varchar
  firstName  varchar
  lastName   varchar
  phone      varchar   [null]
  address    varchar   [default: '']
  role       Role      [default: 'CITIZEN']
  avatarUrl  varchar   [null]
  isActive   boolean   [default: true]
  createdAt  timestamp [default: `now()`]
  updatedAt  timestamp
}

Table Report {
  id                 uuid            [pk]
  title              varchar
  description        text
  category           WasteCategory
  status             ReportStatus    [default: 'PENDING']
  latitude           float
  longitude          float
  address            varchar         [null]
  isAnonymous        boolean         [default: false]
  isDeleted          boolean         [default: false]
  isSpam             boolean         [default: false]
  spamMarkedAt       timestamp       [null]
  spamReason         varchar         [null]
  analysisStatus     AnalysisStatus  [null]
  analysisWasteCount int             [null]
  analysisConfidence float           [null]
  analyzedAt         timestamp       [null]
  severity           Severity        [null]
  aiCategories       text[]
  aiReason           text            [null]
  aiModel            varchar         [null]
  aiImageHash        varchar         [null]
  aiProcessingMs     int             [null]
  aiGeminiMs         int             [null]
  createdAt          timestamp       [default: `now()`]
  updatedAt          timestamp
  reporterId         uuid            [null]
  assignedToId       uuid            [null]
  cleanupScheduleId  uuid            [null]
  incidentId         uuid            [null]
}

Table ReportImage {
  id        uuid      [pk]
  imageUrl  varchar
  publicId  varchar
  type      ImageType [default: 'REPORT']
  createdAt timestamp [default: `now()`]
  reportId  uuid
}

Table StatusHistory {
  id             uuid         [pk]
  previousStatus ReportStatus [null]
  newStatus      ReportStatus
  notes          text         [null]
  createdAt      timestamp    [default: `now()`]
  reportId       uuid
  changedById    uuid
}

Table Notification {
  id        uuid              [pk]
  title     varchar
  message   text
  type      NotificationType
  isRead    boolean           [default: false]
  createdAt timestamp         [default: `now()`]
  userId    uuid
  reportId  uuid              [null]
}

Table ReportingZone {
  id          uuid      [pk]
  name        varchar
  coordinates json
  isActive    boolean   [default: true]
  createdAt   timestamp [default: `now()`]
  updatedAt   timestamp
  createdById uuid
}

Table CleanupSchedule {
  id           uuid                  [pk]
  title        varchar
  description  text
  barangay     varchar
  latitude     float
  longitude    float
  scheduledAt  timestamp
  status       CleanupScheduleStatus [default: 'UPCOMING']
  notes        text                  [null]
  equipment    text[]
  createdAt    timestamp             [default: `now()`]
  updatedAt    timestamp
  createdById  uuid
  verifiedById uuid                  [null]
  verifiedAt   timestamp             [null]
}

Table CleanupScheduleWorker {
  id         uuid      [pk]
  assignedAt timestamp [default: `now()`]
  scheduleId uuid
  workerId   uuid

  indexes {
    (scheduleId, workerId) [unique]
  }
}

Table ReportWorker {
  id         uuid      [pk]
  assignedAt timestamp [default: `now()`]
  reportId   uuid
  workerId   uuid

  indexes {
    (reportId, workerId) [unique]
  }
}

Table WasteIncident {
  id               uuid          [pk]
  category         WasteCategory
  latitude         float
  longitude        float
  address          varchar       [null]
  contributorCount int           [default: 1]
  status           ReportStatus  [default: 'PENDING']
  severity         Severity      [null]
  isResolved       boolean       [default: false]
  createdAt        timestamp     [default: `now()`]
  updatedAt        timestamp
}

Ref: Report.reporterId > User.id
Ref: Report.assignedToId > User.id
Ref: Report.cleanupScheduleId > CleanupSchedule.id
Ref: Report.incidentId > WasteIncident.id
Ref: ReportWorker.reportId > Report.id [delete: cascade]
Ref: ReportWorker.workerId > User.id
Ref: CleanupScheduleWorker.scheduleId > CleanupSchedule.id [delete: cascade]
Ref: CleanupScheduleWorker.workerId > User.id
Ref: CleanupSchedule.createdById > User.id
Ref: CleanupSchedule.verifiedById > User.id
Ref: ReportImage.reportId > Report.id [delete: cascade]
Ref: StatusHistory.reportId > Report.id [delete: cascade]
Ref: StatusHistory.changedById > User.id
Ref: Notification.userId > User.id [delete: cascade]
Ref: Notification.reportId > Report.id [delete: set null]
Ref: ReportingZone.createdById > User.id

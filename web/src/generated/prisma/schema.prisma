generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id           String   @id @default(uuid())
  imageUrl     String
  category     String
  confidence   Float
  latitude     Float
  longitude    Float
  locationName String
  description  String?
  status       String   @default("pending")
  reportedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, status, reportedAt])
  @@index([reportedAt])
}

# Database - Required for Prisma at build time
# For Vercel production, this must be a NeonDB connection string with sslmode=require
# Format: postgresql://username:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-YOUR-REGION.neon.tech/neondb?sslmode=require"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
BACKEND_API_URL="http://localhost:5000/api"
YOLO_API_URL="http://localhost:8000/predict"

# Debug Mode
DEBUG_PRISMA="false"

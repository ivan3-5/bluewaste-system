# Database Configuration
# For Vercel: Use NeonDB connection string with sslmode=require
# Format: postgresql://username:password@host:5432/dbname?sslmode=require
# Make sure to include: ?sslmode=require for SSL connections

DATABASE_URL="postgresql://neondb_owner:npg_q4UilKyaZdu2@ep-solitary-thunder-a1ajp2py-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_q4UilKyaZdu2@ep-solitary-thunder-a1ajp2py.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# For connection pooling (optional, use with Neon PostgreSQL pooler):
# DATABASE_URL="postgresql://user:password@pool.neon.tech:6432/dbname?sslmode=require"

# Security - JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="replace-with-a-long-random-secret-min-32-characters"

# Security - Refresh Token Secret (must be DIFFERENT from JWT_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_SECRET="replace-with-another-long-random-secret-min-32-characters"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Server Configuration
PORT="5000"
NODE_ENV="development"

# CORS Configuration
WEB_URL="http://localhost:3000"
MOBILE_URL="http://localhost:8081"
ALLOWED_ORIGINS="http://localhost:19006,http://127.0.0.1:19006"

# Optional: Machine Learning Model API (hybrid YOLOv8 + Cloud Vision pipeline)
# Locally: http://localhost:8000/analyze
# On Render: https://bluewaste-system.onrender.com/analyze
YOLO_API_URL="https://bluewaste-system.onrender.com/analyze"

GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Spam Report Configuration (days to keep spam reports)
SPAM_RETENTION_DAYS="3"

# ---------------------------------------------------------------------------
# Upstash Redis — shared rate limiting store for multi-instance / serverless.
# Leave unset to fall back to in-memory store (safe for single-instance dev).
# Free tier: https://console.upstash.com
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ---------------------------------------------------------------------------
# Seed passwords — loaded by prisma/seed.ts. Never hardcode in source.
# Seed will abort if these are not set (and always aborts on NODE_ENV=production).
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_WORKER_PASSWORD="change-me-before-seeding"
SEED_CITIZEN_PASSWORD="change-me-before-seeding"
